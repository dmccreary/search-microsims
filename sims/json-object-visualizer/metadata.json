        "colorContrast": true
      }
    },
    "userInterface": {
      "layoutType": "multi-panel",
      "layoutPattern": "tree-top-controls-bottom",
      "controls": [
        {
          "id": "json-input",
          "type": "text-input",
          "label": "Paste JSON here",
          "description": "Text area holding the JSON document to draw"
        },
        {
          "id": "visualize-btn",
          "type": "button",
          "label": "Visualize",
          "description": "Parse the text and draw it as a tree"
        },
        {
          "id": "sample-btn",
          "type": "button",
          "label": "Load Sample",
          "description": "Restore the sample MicroSim metadata document"
        },
        {
          "id": "expand-btn",
          "type": "button",
          "label": "Expand All",
          "description": "Open every object and array"
        },
        {
          "id": "collapse-btn",
          "type": "button",
          "label": "Collapse All",
          "description": "Close every object and array below the root"
        },
        {
          "id": "values-check",
          "type": "checkbox",
          "label": "Show Values",
          "description": "Show or hide primitive values next to their key names"
        }
      ]
    },
